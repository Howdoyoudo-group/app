{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "howdoyoudo.group" }],
      "destination": "https://www.howdoyoudo.co.uk/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.howdoyoudo.group" }],
      "destination": "https://www.howdoyoudo.co.uk/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://wgistckxxbfpsuulbswr.supabase.co/functions/v1/generate-sitemap" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }]
    }
  ]
}
